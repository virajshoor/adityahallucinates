command: "cd /workspace && python3 - <<'PY'\n\"\"\"Fixed-depth classical vs HalfKA self-play.\"\"\"\nfrom __future__ import annotations\nimport os, chess, chess.engine\nfrom pathlib import Path\nROOT=Path('.').resolve()\nADITYA=str(ROOT/'build/aditya')\nNET=str(ROOT/'nets/halfka.nnue')\nGAMES=24\nDEPTH=6\n\ndef play(white, black, depth):\n    board=chess.Board()\n    engines={chess.WHITE:white, chess.BLACK:black}\n    lim=chess.engine.Limit(depth=depth)\n    while not board.is_game_over(claim_draw=True):\n        eng=engines[board.turn]\n        try:\n            mv=eng.play(board, lim).move\n        except Exception:\n            return 0.0 if board.turn==chess.WHITE else 1.0\n        if mv is None or mv not in board.legal_moves:\n            return 0.0 if board.turn==chess.WHITE else 1.0\n        board.push(mv)\n        if board.ply()>300: break\n    res=board.result(claim_draw=True)\n    return 1.0 if res=='1-0' else 0.0 if res=='0-1' else 0.5\n\nenv_c=os.environ.copy(); env_c['ADITYA_USE_NNUE']='0'\nenv_n=os.environ.copy(); env_n['ADITYA_USE_NNUE']='1'; env_n['ADITYA_NNUE_BLEND']='0'; env_n['ADITYA_NNUE']=NET\n# Prefer float for correctness; optional int16 speed via ADITYA_NNUE_FLOAT=0\nclassic=chess.engine.SimpleEngine.popen_uci(ADITYA, env=env_c)\nnnue=chess.engine.SimpleEngine.popen_uci(ADITYA, env=env_n)\nclassic.configure({'Hash':128,'Threads':1})\nnnue.configure({'Hash':128,'Threads':1,'EvalFile':NET})\nprint(f'HalfKA depth={DEPTH} games={GAMES}', flush=True)\npoints=0.0\ntry:\n  for g in range(GAMES):\n    nnue_w=(g%2==0)\n    if nnue_w:\n      w=play(nnue,classic,DEPTH); n=w\n    else:\n      w=play(classic,nnue,DEPTH); n=1.0-w\n    points+=n\n    print(f'game {g+1}/{GAMES}: nnue={\"W\" if nnue_w else \"B\"} score={n} running={points/(g+1):.3f}', flush=True)\n  print(f'NNUE score {points}/{GAMES} = {points/GAMES:.3f} depth={DEPTH}')\nfinally:\n  classic.quit(); nnue.quit()\nPY\necho DONE_DEPTH_SELFPLAY"
